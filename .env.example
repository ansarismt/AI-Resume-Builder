# Local development defaults. Never use these values for a deployment.
DJANGO_SECRET_KEY=generate-a-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_DB_NAME=db.sqlite3
TOKEN_TTL_DAYS=14

# Comma-separated browser origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080

# Production defaults are secure when DJANGO_DEBUG=False. Uncomment only to override.
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_CONTENT_TYPE_NOSNIFF=True
# X_FRAME_OPTIONS=DENY

# Optional text-generation provider. Keep credentials on the backend only.
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
LLM_TEMPERATURE=
LLM_MAX_TOKENS=2048

# Frontend API address (Vite).
VITE_API_URL=http://127.0.0.1:8000/api
